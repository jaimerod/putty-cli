# putty-cli configuration
# Copy this file to .env and fill in your values. .env is gitignored.
# Real environment variables always take precedence over .env values.

# Required: path to your PuTTY .reg export file (Winget/OneDrive etc.)
PUTTY_REG_PATH=/mnt/c/Users/YOURWINDOWSUSER/OneDrive/Shared/portable/PuTTY/Data/settings/putty.reg

# Optional: where tmux session logs are written.
# Default: the directory containing the .reg file, or ~/.putty-cli/logs
#PUTTY_LOG_DIR=/mnt/c/Users/YOURWINDOWSUSER/OneDrive/Shared/portable/PuTTY

# Optional: TUI color theme; default monokai (this example file shows
# the alternative). See utils/palette_util.py
PUTTY_THEME=far